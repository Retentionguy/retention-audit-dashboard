# PTEMaster — Environment Variables
# Copy this to .env.local and fill in real values
# SECURITY: Never commit .env.local to git

# ── Supabase (P0.1) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=        # SERVER SIDE ONLY — never expose client-side

# ── Stripe (P0.2) ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...     # or sk_test_... for testing
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREDITS_1=price_...  # $4.99 — 1 test credit
STRIPE_PRICE_CREDITS_3=price_...  # $9.99 — 3 test credits
STRIPE_PRICE_CREDITS_8=price_...  # $19.99 — 8 test credits
STRIPE_PRICE_MONTHLY=price_...    # $14.99/mo Smart Prep
STRIPE_PRICE_ANNUAL=price_...     # $119.99/yr Annual

# ── Claude API (P0.3 + P1.1) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...      # For AI coaching and writing scoring

# ── OpenAI (P0.3 speaking scoring) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...             # For Whisper speech-to-text transcription

# ── Resend Email (P0.4) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ptemaster.com
JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=3000
